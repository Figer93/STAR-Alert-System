# ── Railway Backend ───────────────────────────────────────────────────────────
BACKEND_URL=https://your-app.railway.app       # Railway backend URL (all collector services POST here)

# ── UniFi Controller ──────────────────────────────────────────────────────────
UNIFI_URL=https://192.168.1.1                  # Your UniFi Controller IP/hostname
UNIFI_PORT=8443                                # Default UniFi management port
UNIFI_USER=star-monitor                        # Read-only account (see README for setup)
UNIFI_PASS=your_password
UNIFI_SITE=default                             # Site name shown in UniFi dashboard (usually 'default')
UNIFI_VERIFY_SSL=false                         # UniFi uses a self-signed certificate by default

# ── Network Targets ───────────────────────────────────────────────────────────
GATEWAY_IP=192.168.1.1                         # pfSense LAN IP (also the default gateway)
WAN1_GATEWAY_IP=                               # Primary ISP gateway — first hop on WAN1 (run: tracert 8.8.8.8 on WAN1)
WAN2_GATEWAY_IP=                               # Secondary ISP gateway — first hop on WAN2 (leave blank if single-WAN)
ISP_GATEWAY_IP=                                # Legacy single-WAN gateway — ignored when WAN1_GATEWAY_IP is set
INTERNAL_IPS=                                  # Comma-separated internal targets, e.g. 10.2.1.5,10.2.1.3,10.2.2.100
WAN_MONITOR_IPS=8.8.8.8,1.1.1.1               # Comma-separated public IPs to monitor as WAN targets (default: 8.8.8.8,1.1.1.1)

# ── NetFlow ───────────────────────────────────────────────────────────────────
NETFLOW_PORT=9995                              # Must match pfSense → Services → softflowd port

# ── Collector Identity ────────────────────────────────────────────────────────
COLLECTOR_ID=office-main                       # Unique name if you run multiple collector instances
                                               # (e.g. office-main, branch-london)
