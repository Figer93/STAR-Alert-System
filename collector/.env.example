# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase dashboard → Project Settings → API

SUPABASE_URL=https://xxxx.supabase.co          # Your Supabase project URL
SUPABASE_KEY=your_service_role_key             # Settings → API → service_role key (NOT anon key)

# Direct PostgreSQL connection string for Telegraf (bypasses PostgREST).
# Find in: Supabase dashboard → Project Settings → Database → Connection string
# Use the "Direct connection" URI (port 5432), NOT the pooled/PgBouncer one.
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# ── UniFi Controller ──────────────────────────────────────────────────────────
UNIFI_URL=https://192.168.1.1                  # Your UniFi Controller IP/hostname
UNIFI_PORT=8443                                # Default UniFi management port
UNIFI_USER=star-monitor                        # Read-only account (see README for setup)
UNIFI_PASS=your_password
UNIFI_SITE=default                             # Site name shown in UniFi dashboard (usually 'default')
UNIFI_VERIFY_SSL=false                         # UniFi uses a self-signed certificate by default

# ── Network Targets ───────────────────────────────────────────────────────────
GATEWAY_IP=192.168.1.1                         # pfSense LAN IP (also the default gateway)
ISP_GATEWAY_IP=                                # First hop beyond pfSense — run: tracert 8.8.8.8
                                               # Leave blank if unknown; fping will still test
                                               # 8.8.8.8 and 1.1.1.1 as WAN targets.

# ── NetFlow ───────────────────────────────────────────────────────────────────
NETFLOW_PORT=9995                              # Must match pfSense → Services → softflowd port

# ── Collector Identity ────────────────────────────────────────────────────────
COLLECTOR_ID=office-main                       # Unique name if you run multiple collector instances
                                               # (e.g. office-main, branch-london)
